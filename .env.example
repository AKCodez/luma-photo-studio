# Copy this file to .env.local and fill in your own keys.
# Never commit .env.local — it is gitignored.

# Luma Dream Machine API key — image generation + editing
# Get one at https://lumalabs.ai/dream-machine/api/keys
LUMA_API_KEY=

# Anthropic API key — Claude Sonnet for "Surprise Me" scene authoring
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Vercel Blob token — image + manifest storage
# Auto-populated by `vercel env pull .env.local` once you've linked
# the project and connected a Blob store. Can be empty for local dev
# (the app falls back to filesystem storage in ./data and ./public).
BLOB_READ_WRITE_TOKEN=
